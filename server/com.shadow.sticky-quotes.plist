<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shadow.sticky-quotes</string>
  <!-- launchd has no shell PATH — the node binary must be an absolute path.
       Verify it matches `which node` before loading. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/Cellar/node@24/24.14.1_1/bin/node</string>
    <string>/Users/tom/shadow/sticky-quotes/server/notes-api.js</string>
  </array>
  <!-- Repo root, so the server's scoped `git add sticky-quotes-data/` auto-commit works. -->
  <key>WorkingDirectory</key>
  <string>/Users/tom/shadow</string>
  <!-- HOME lets git find ~/.gitconfig for commit authorship under launchd. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/tom</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/tom/Library/Logs/shadow/sticky-quotes.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tom/Library/Logs/shadow/sticky-quotes.stderr.log</string>
</dict>
</plist>
